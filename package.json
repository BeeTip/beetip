{
  "name": "beetip",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "description": "BeeTip community jastip marketplace monorepo",
  "scripts": {
    "dev": "pnpm --filter @beetip/web dev",
    "build": "pnpm --filter @beetip/web build",
    "lint": "eslint apps packages supabase/functions tests *.ts *.mjs",
    "typecheck": "pnpm --filter @beetip/web exec next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:staging": "node scripts/check-staging.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "26.1.0",
    "pg": "8.16.3",
    "standardwebhooks": "1.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
